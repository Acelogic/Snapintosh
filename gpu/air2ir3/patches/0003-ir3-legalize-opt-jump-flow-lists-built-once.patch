+/* The flow instructions with a target (jumps and branches) of one block, in instruction order. opt_jump
+ * only reads and retargets these; the one change it makes to the set is dropping a jump to the next block,
+ * so the list is built once for all opt_jump passes instead of walking every instruction of every block
+ * on each pass (each pass restarts after a block is deleted, which made the walk quadratic).
+ */
+struct opt_jump_block {
+   struct ir3_block *block;
+   void *saved_data;
+   struct ir3_instruction **flow;
+   unsigned count;
+};
+
+static void
+opt_jump_forget(struct opt_jump_block *jb, struct ir3_instruction *instr)
+{
+   for (unsigned i = 0; i < jb->count; i++) {
+      if (jb->flow[i] == instr) {
+         memmove(&jb->flow[i], &jb->flow[i + 1],
+                 (jb->count - i - 1) * sizeof(jb->flow[0]));
+         jb->count--;
+         return;
+      }
+   }
+}
