+/* Runs opt_jump to a fixed point; returns whether it changed the CFG. */
+static bool
+opt_jumps(struct ir3 *ir)
+{
+   void *mem_ctx = ralloc_context(NULL);
+   struct util_dynarray blocks;
+   util_dynarray_init(&blocks, mem_ctx);
+
+   foreach_block (block, &ir->block_list) {
+      struct opt_jump_block *jb = rzalloc(mem_ctx, struct opt_jump_block);
+      unsigned n = 0;
+      foreach_instr (instr, &block->instr_list) {
+         if (is_flow(instr) && instr->cat0.target)
+            n++;
+      }
+      jb->block = block;
+      jb->saved_data = block->data;
+      jb->flow = ralloc_array(mem_ctx, struct ir3_instruction *, MAX2(n, 1));
+      foreach_instr (instr, &block->instr_list) {
+         if (is_flow(instr) && instr->cat0.target)
+            jb->flow[jb->count++] = instr;
+      }
+      block->data = jb;
+      util_dynarray_append(&blocks, jb);
+   }
+
+   bool cfg_changed = false;
+   while (opt_jump(ir))
+      cfg_changed = true;
+
+   util_dynarray_foreach (&blocks, struct opt_jump_block *, jb)
+      (*jb)->block->data = (*jb)->saved_data;
+   ralloc_free(mem_ctx);
+   return cfg_changed;
+}
