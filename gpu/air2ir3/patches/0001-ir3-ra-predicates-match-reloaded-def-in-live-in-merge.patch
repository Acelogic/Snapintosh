diff --git a/src/freedreno/ir3/ir3_ra_predicates.c b/src/freedreno/ir3/ir3_ra_predicates.c
index e61803f..1539c6d 100644
--- a/src/freedreno/ir3/ir3_ra_predicates.c
+++ b/src/freedreno/ir3/ir3_ra_predicates.c
@@ -414,8 +414,16 @@ ra_block(struct ra_predicates_ctx *ctx, struct ir3_block *block)
 
          struct live_def *cur_def = &live->live_defs[reg];
 
-         /* Same def in the same register, nothing to be done. */
-         if (cur_def->def == succ_def->def)
+         /* Same def in the same register, nothing to be done.
+          *
+          * The reloaded def has to match as well: the successor's instructions
+          * use get_def(succ_def). If only the pre-RA def matched, the value on
+          * this edge would be provided by a different instruction (e.g. the
+          * original def) that may never be used directly and is then deleted
+          * at the end of this pass, leaving a stale predicate in the register.
+          */
+         if (cur_def->def == succ_def->def &&
+             cur_def->reloaded_def == succ_def->reloaded_def)
             continue;
 
          /* Different def in the same register, free it first. */
@@ -469,9 +477,20 @@ init_block_liveness(struct ra_predicates_ctx *ctx, struct ir3_block *block)
              */
             if (BITSET_TEST(live_in, pred_def->def->name))
                *cur_def = *pred_def;
-         } else if (cur_def->def != pred_def->def) {
+         } else if (cur_def->def != pred_def->def ||
+                    cur_def->reloaded_def != pred_def->reloaded_def) {
             /* Different predecessors have different live-out defs in reg so we
              * cannot use it as live-in.
+             *
+             * This includes the same pre-RA def provided by different
+             * instructions (the original def in one predecessor, a reloaded
+             * clone in another): uses in this block would be rewritten to the
+             * first predecessor's instruction, and if the original def ends up
+             * with no direct use it is removed at the end of this pass, so the
+             * register would hold a stale predicate on the other path.
+             * Found with the QuartzCore generic fragment shader
+             * (fixed_frag_lph_cpf, PBGRA_Xgfc): "ra validation fail: wrong
+             * definition reaches source".
              */
             cur_def->def = NULL;
             cur_def->reloaded_def = NULL;
