# Apple firmware. The restore image and everything unpacked from it are Apple's
# and stay on the machine that downloaded them -- roughly 25 GB, none of it ours
# to redistribute. tools/fetch-ipsw.py and tools/extract-firmware.py rebuild the
# whole tree from scratch, so nothing here is lost by excluding it.
downloads/

# Probe binaries, native test executables, disassembly, captures and run logs.
# The build and run scripts beside them are the record of how each run was
# made (docs cite them by name), so those are tracked.
build/*
!build/*.py
!build/*.sh
!build/*.ps1

__pycache__/
*.pyc
*.o
*.elf
*.bin
.DS_Store

# Agent worktrees and local session state -- never part of the project.
.claude/

# air2ir3 (gpu/air2ir3): the private Mesa checkout (tools/mesa-setup.sh
# rebuilds it at the pinned revision), build outputs, the precompiled cache and
# sweep results are regenerated by the tree's own scripts. The corpus is
# bitcode extracted from Apple's frameworks and stays on this machine.
gpu/air2ir3/third_party/
gpu/air2ir3/build/
gpu/air2ir3/cache/
gpu/air2ir3/results/
gpu/air2ir3/scratch/
gpu/air2ir3/corpus

# Research inputs for the Adreno work (WindowServer's Metal usage, the local
# conformance harness): captures and extracts from this Mac's macOS.
gpu/adreno/

# --- public release (AUDIT.md 7.3) ---
._*
*.orig
*.rej
*.dSYM/
# Per-machine cycle pins (start from tools/cycle_lib/pins.example.json).
tools/cycle_lib/pins.json
# Reconstructed Apple class headers, generated from your own KDK.
*26A428.h
# Compiled from Apple shaders or with embedded build paths; generated locally.
render-shaders*.json
p7-shaders*.json
gpu/air2ir3/tools/a16ref/probes.air
# Never commit Apple / vendor inputs or credentials.
*.ipsw
*.dmg
*.im4p
*.img4
*.kc
kernelcache*
*.kext/
# ... except the two codeless kexts kept as source.
!drivers/*/*.kext/
*.mbn
*.fw
*.inf
*.sys
*.cat
*.aml
*.jsonl
*.pem
*.key
*.p12
id_*
a16?q1n1*
.env
